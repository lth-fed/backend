{
  "db_name": "PostgreSQL",
  "query": "\n            select distinct\n                g.id, g.path, g.limit_membership_visibility,\n                g.name as \"name!: DIS\",\n                g.description as \"description!: DIS\",\n                g.deleted\n            from groups g\n            join group_memberships gm on gm.user_id = $1\n            join groups mg on mg.id = gm.group_id\n            where subpath(g.path, 0, 1) = subpath(mg.path, 0, 1)\n            order by g.path\n        ",
