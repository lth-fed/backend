{
  "db_name": "PostgreSQL",
  "query": "\n            select distinct\n                g.id, g.path, g.limit_membership_visibility,\n                g.name as \"name!: DIS\",\n                g.description as \"description!: DIS\",\n                g.deleted\n            from group_memberships gm\n            join groups g on g.id = gm.group_id\n            where gm.user_id = $1\n            order by g.path\n        ",
