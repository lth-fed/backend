  "query": "select\n            p.id,\n            p.group_id,\n            p.kind::text as \"kind!\",\n            p.name as \"name!: DIS\",\n            p.description as \"description!: DIS\",\n            p.sales_price,\n            p.sales_organization,\n            p.sales_stock,\n            p.stock_real,\n            p.stock_unit,\n            p.stock_price::float8 as \"stock_price!\",\n            p.bookkeeping_tag,\n            p.max_uses,\n            p.sales_start,\n            p.sales_stop,\n            p.resale_start,\n            p.resale_stop,\n            p.store_general_sales,\n            p.store_online_self_serve,\n            p.store_internal_id,\n            p.store_alcohol_by_volume,\n            p.tickets_guaranteed,\n            p.tickets_require_other,\n            p.tickets_been_released,\n            p.been_purchased,\n            array(select activity_id from product_activity_assignments\n                where product_id = p.id order by activity_id) as \"activity_ids!: Vec<Uuid>\",\n            array(select group_id from product_transfer_groups\n                where product_id = p.id order by group_id) as \"transfer_group_ids!: Vec<Uuid>\",\n            array(select group_id from product_allowed_groups\n                where product_id = p.id order by group_id) as \"allowed_group_ids!: Vec<Uuid>\",\n            array(select addon_id from product_addon_links\n                where product_id = p.id order by addon_id) as \"addon_ids!: Vec<Uuid>\"\n        from products p\n        where p.id = $1",
