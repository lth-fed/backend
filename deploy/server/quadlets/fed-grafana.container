[Unit]
Description=Grafana

[Container]
ContainerName=fed-grafana
Image=docker.io/grafana/grafana-enterprise:13.0.3
Network=teknologappen.network
Network=traefik.network
EnvironmentFile=/etc/teknologappen/grafana.env
Volume=/srv/teknologappen/backend/grafana.yml:/etc/grafana/provisioning/datasources/all.yml:ro
Volume=grafana-storage.volume:/var/lib/grafana
Label=traefik.enable=true
Label=traefik.docker.network=traefik
Label=traefik.http.routers.fed-grafana.rule=Host(`grafana.teknologappen.se`)
Label=traefik.http.routers.fed-grafana.entrypoints=websecure
Label=traefik.http.routers.fed-grafana.tls=true
Label=traefik.http.routers.fed-grafana.tls.certresolver=letsencrypt
Label=traefik.http.routers.fed-grafana.service=fed-grafana
Label=traefik.http.services.fed-grafana.loadbalancer.server.port=3000

[Service]
Restart=always

[Install]
WantedBy=teknologappen.target
