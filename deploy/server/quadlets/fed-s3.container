[Unit]
Description=RustFS object storage

[Container]
ContainerName=fed-s3
Image=docker.io/rustfs/rustfs:latest
Network=teknologappen.network
Network=traefik.network
EnvironmentFile=/etc/teknologappen/s3.env
# :U gives the rustfs user ownership.
Volume=/fed/s3:/data:U
Label=traefik.enable=true
Label=traefik.docker.network=traefik
Label=traefik.http.routers.fed-s3.rule=Host(`s3.teknologappen.se`)
Label=traefik.http.routers.fed-s3.entrypoints=websecure
Label=traefik.http.routers.fed-s3.tls=true
Label=traefik.http.routers.fed-s3.tls.certresolver=letsencrypt
Label=traefik.http.routers.fed-s3.service=fed-s3
Label=traefik.http.services.fed-s3.loadbalancer.server.port=9000
Label=traefik.http.routers.fed-s3.middlewares=fed-s3-cors@docker
Label=traefik.http.middlewares.fed-s3-cors.headers.accesscontrolalloworiginlist=https://app.teknologappen.se,https://admin.teknologappen.se
Label=traefik.http.middlewares.fed-s3-cors.headers.accesscontrolallowmethods=GET,HEAD,PUT,POST,DELETE,OPTIONS
Label=traefik.http.middlewares.fed-s3-cors.headers.accesscontrolallowheaders=*
Label=traefik.http.middlewares.fed-s3-cors.headers.accesscontrolexposeheaders=ETag
Label=traefik.http.middlewares.fed-s3-cors.headers.accesscontrolmaxage=86400
Label=traefik.http.middlewares.fed-s3-cors.headers.addvaryheader=true
Label=traefik.enable=true
Label=traefik.docker.network=traefik
Label=traefik.http.routers.fed-s3-console.rule=Host(`s3-console.teknologappen.se`)
Label=traefik.http.routers.fed-s3-console.entrypoints=websecure
Label=traefik.http.routers.fed-s3-console.tls=true
Label=traefik.http.routers.fed-s3-console.tls.certresolver=letsencrypt
Label=traefik.http.routers.fed-s3-console.service=fed-s3-console
Label=traefik.http.services.fed-s3-console.loadbalancer.server.port=9001

[Service]
Restart=always

[Install]
WantedBy=teknologappen.target
