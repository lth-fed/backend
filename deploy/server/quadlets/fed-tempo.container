[Unit]
Description=Tempo traces

[Container]
ContainerName=fed-tempo
Image=docker.io/grafana/tempo:3.0.2
Network=teknologappen.network
Exec=-target=all -config.file=/etc/tempo.yaml
Volume=/srv/teknologappen/backend/tempo.yaml:/etc/tempo.yaml:ro
Volume=tempo-data.volume:/var/tempo

[Service]
Restart=always

[Install]
WantedBy=teknologappen.target
