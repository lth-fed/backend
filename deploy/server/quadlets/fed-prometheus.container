[Unit]
Description=Prometheus metrics

[Container]
ContainerName=fed-prometheus
Image=docker.io/prom/prometheus:v3.13.0
Network=teknologappen.network
Exec=--config.file=/etc/prometheus/prometheus.yml --storage.tsdb.path=/prometheus --storage.tsdb.retention.time=60d
Volume=/srv/teknologappen/backend/prometheus.yml:/etc/prometheus/prometheus.yml:ro
Volume=prometheus-data.volume:/prometheus

[Service]
Restart=always

[Install]
WantedBy=teknologappen.target
