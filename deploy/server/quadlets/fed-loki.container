[Unit]
Description=Loki logs

[Container]
ContainerName=fed-loki
Image=docker.io/grafana/loki:3.7.0
Network=teknologappen.network
User=10001:10001
Exec=-config.file=/etc/loki/config.yaml -target=all
Volume=/srv/teknologappen/backend/loki-config.yaml:/etc/loki/config.yaml:ro
# :U replaces the old chown init container.
Volume=loki-storage.volume:/var/loki:U

[Service]
Restart=always

[Install]
WantedBy=teknologappen.target
