  "query": "select payment_reference as \"payment_reference?\", client_id as \"client_id?\",\n            refund_reference as \"refund_reference?\", refund_at,\n            total_transaction_fee as \"total_transaction_fee?\",\n            customer_id as \"customer_id?\", provider as \"provider?: Provider\",\n            cancelled_at,\n            (select coalesce(sum(amount), '0.00'::money) from transaction_wares\n                where transaction_wares.transaction_id = t.id) as \"total!\",\n            --\n            t.id as \"id!\"\n            from unnest($1::uuid[]) as t(id)\n            left join transactions on transactions.id = t.id",
